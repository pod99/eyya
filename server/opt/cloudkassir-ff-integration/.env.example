NODE_ENV=development
PORT=3100
DATABASE_URL="file:./dev.db"

# Keep true until the test cash register and API credentials are ready.
DRY_RUN=true

# CloudKassir / CloudPayments API.
CLOUDKASSIR_BASE_URL=https://api.cloudpayments.ru
CLOUDKASSIR_PUBLIC_ID=
CLOUDKASSIR_API_SECRET=
CLOUDKASSIR_INN=
CLOUDKASSIR_TAXATION_SYSTEM=1
CLOUDKASSIR_CALCULATION_PLACE=https://example.ru
CLOUDKASSIR_RUSSIA_TIME_ZONE=2

# FF Platform API.
FF_PLATFORM_BASE_URL=https://ff-platform.ru/lk/1
FF_PLATFORM_TOKEN=
FF_SCAN_ENABLED=true
FF_SCAN_MODE=cdek_period
FF_SCAN_LOOKBACK_DAYS=7
FF_SCAN_STATUSES=sended
FF_SCAN_START_ID=0
FF_SCAN_BATCH_SIZE=300
FF_SCAN_CONCURRENCY=10
FF_SCAN_INTERVAL_MS=60000

# Worker settings.
WORKER_POLL_INTERVAL_MS=60000
CLOUDKASSIR_POLL_ENABLED=true
CLOUDKASSIR_POLL_INTERVAL_MS=1800000
CLOUDKASSIR_POLL_LOOKBACK_MINUTES=60
CLOUDKASSIR_POLL_TIME_ZONE=MSK
CLOUDKASSIR_POLL_MAX_PAGES=20
CLOUDKASSIR_POLL_RECEIPT_PAGE_LIMIT=100
CLOUDKASSIR_POLL_KNOWN_RECEIPT_LIMIT=200
EXTERNAL_API_TIMEOUT_MS=30000
ORDER_RECONSTRUCT_ENABLED=true
ORDER_RECONSTRUCT_BATCH_SIZE=50
ORDER_RECONSTRUCT_DATE_FROM=
ORDER_RECONSTRUCT_DATE_TO=
CLOUDKASSIR_WEBHOOK_SECRET=
ADMIN_SECRET=
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
FISCAL_RECEIPT_SENDING_TIMEOUT_MS=600000
